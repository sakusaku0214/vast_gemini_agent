# Copy to %LOCALAPPDATA%\VastGeminiAgent\secrets\secrets.env.
# Never commit real values.
DISCORD_BOT_TOKEN=replace-with-your-bot-token
DISCORD_CHANNEL_ID=123456789012345678
DISCORD_OWNER_USER_ID=123456789012345678
GEMINI_API_KEY=replace-with-your-key
# Optional; required only when external_tools.search_provider is brave.
SEARCH_API_KEY=
